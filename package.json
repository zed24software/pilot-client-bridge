{
  "name": "pilot-client-bridge",
  "version": "1.0.7",
  "description": "",
  "main": "src/index.ts",
  "scripts": {
    "dev": "nodemon --watch ./src ./src/index.ts",
    "build": "node scripts/embed-tray-bin.mjs && bun build ./src/index.ts --compile --minify --sourcemap --target=bun-windows-x64-baseline --outfile ./dist/24client-bridge --windows-icon=src/assets/icon.ico --windows-title=\"24client-bridge\" --windows-description=\"Bridge application connecting 24client to Discord\" --windows-copyright=\"Zedruc and awdev_\"",
    "build:mac-arm64": "node scripts/embed-tray-bin.mjs && bun build ./src/index.ts --compile --minify --sourcemap --target=bun-darwin-arm64 --outfile ./dist/24client-bridge-mac-arm64",
    "build:mac-x64": "node scripts/embed-tray-bin.mjs && bun build ./src/index.ts --compile --minify --sourcemap --target=bun-darwin-x64 --outfile ./dist/24client-bridge-mac-x64",
    "build:mac": "bun run build:mac-arm64 && bun run build:mac-x64",
    "build:linux-x64": "node scripts/embed-tray-bin.mjs && bun build ./src/index.ts --compile --minify --sourcemap --target=bun-linux-x64 --outfile ./dist/24client-bridge-linux-x64",
    "build:linux-arm64": "node scripts/embed-tray-bin.mjs && bun build ./src/index.ts --compile --minify --sourcemap --target=bun-linux-arm64 --outfile ./dist/24client-bridge-linux-arm64",
    "build:linux": "bun run build:linux-x64 && bun run build:linux-arm64",
    "build-installer": "bun run build && node scripts/build-installer.mjs",
    "serve": "bun run build && bun build-installer"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.18.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "node-ipc": "^12.0.0",
    "node-notifier": "^10.0.1",
    "open": "^11.0.0",
    "systray2": "^2.1.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.4",
    "@types/node-ipc": "^9.2.3",
    "@types/node-notifier": "^8.0.5",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "@types/bun": "latest"
  },
  "private": true
}
